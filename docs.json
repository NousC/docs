                "group": "Intent Signals",
                "pages": [
                  "providers/rb2b"
                ]
              },
              {
                "group": "CRM",
                "pages": [
                  "providers/hubspot",
                  "providers/pipedrive",
                  "providers/attio"
                ]
              },
              {
                "group": "Enrichment",
                "pages": [
                  "providers/prospeo",
                  "providers/apollo"
                ]
              },
              {
                "group": "Webhooks",
                "pages": [
                  "webhooks/overview",
                  "webhooks/instantly",
                  "webhooks/emailbison",
                  "webhooks/heyreach",
                  "webhooks/smartlead",
                  "webhooks/fireflies",
                  "webhooks/fathom",
                  "webhooks/rb2b",
                  "webhooks/calendly",
                  "webhooks/cal-com",
