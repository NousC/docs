{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Nous",
  "colors": {
    "primary": "#101011",
    "light": "#f6f5f2",
    "dark": "#101011"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#fbfbfa",
      "dark": "#0e0e10"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "vesper"
      }
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/introduction",
              "getting-started/how-it-works",
              "getting-started/quickstart",
              "getting-started/score-a-list"
            ]
          },
          {
            "group": "Installation",
            "pages": [
              "installation/docker-compose",
              "installation/development-environment"
            ]
          },
          {
            "group": "Providers",
            "pages": [
              "providers/overview",
              "providers/add-new-provider",
              {
                "group": "Communication",
                "pages": [
                  "providers/gmail",
                  "providers/smtp",
                  "providers/linkedin",
                  "providers/slack"
                ]
              },
              {
                "group": "Outbound",
