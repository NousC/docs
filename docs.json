  "logo": {
    "light": "/logo/nous-light.svg",
    "dark": "/logo/nous-dark.svg",
    "href": "https://www.opennous.cloud"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/NousC/opennous"
