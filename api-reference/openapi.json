{
  "openapi": "3.1.0",
  "info": {
    "title": "Nous Public API",
    "description": "The v2 Context API — eight endpoints. The agent reads engineered, epistemics-tagged context and writes observations. Nous derives the rest.",
    "version": "2.0.0"
  },
  "servers": [
    { "url": "https://api.opennous.cloud", "description": "Nous Cloud" }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Workspace API key. Create at Settings → API Keys. Workspace-scoped — no separate workspace ID required."
      }
    },
    "schemas": {
      "AmbiguousFocus": {
        "type": "object",
        "description": "Returned when a name matches several candidates. Pick one and re-call with focus = candidate.entity_id.",
        "properties": {
          "status": { "type": "string", "enum": ["ambiguous"] },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity_id": { "type": "string", "format": "uuid" },
                "name":      { "type": "string" },
                "detail":    { "type": "string", "description": "Short context line — e.g. 'VP Sales @ Acme'" }
              }
            }
          }
        }
      },
      "Claim": {
        "type": "object",
        "description": "A derived fact about an entity. Every claim carries its epistemics.",
        "properties": {
          "property":         { "type": "string", "description": "e.g. 'title', 'stage', 'intent'" },
          "value":            {},
          "confidence":       { "type": "number", "minimum": 0, "maximum": 1 },
          "freshness":        { "type": "string", "enum": ["fresh", "aging", "suspect", "expired"] },
          "epistemic_class":  { "type": "string", "enum": ["observed", "derived", "asserted"] },
          "sources":          { "type": "array", "items": { "type": "string" } },
          "last_observed_at": { "type": "string", "format": "date-time" }
        }
      },
      "Observation": {
        "type": "object",
        "required": ["kind", "property"],
        "properties": {
          "kind":        { "type": "string", "enum": ["event", "state"] },
          "property":    { "type": "string" },
          "value":       {},
          "source":      { "type": "string" },
          "method":      { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "external_id": { "type": "string" },
          "raw":         { "type": "object" }
        }
      },
      "AccountRecord": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "object",
            "properties": {
              "id":   { "type": "string", "format": "uuid" },
              "type": { "type": "string", "enum": ["person", "company"] },
              "name": { "type": "string" }
            }
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind":  { "type": "string", "enum": ["email", "linkedin_url", "domain", "phone"] },
                "value": { "type": "string" }
              }
            }
          },
          "claims": { "type": "array", "items": { "$ref": "#/components/schemas/Claim" } },
          "recent_observations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind":        { "type": "string" },
                "property":    { "type": "string" },
                "observed_at": { "type": "string", "format": "date-time" },
                "value":       {}
              }
            }
          }
        }
      },
      "DedupItem": {
        "type": "object",
        "properties": {
          "kind":      { "type": "string", "enum": ["email", "linkedin_url"] },
          "value":     { "type": "string" },
          "status":    { "type": "string", "enum": ["net_new", "engaged", "recent", "bounced", "unsubscribed", "suppressed"] },
          "entity_id": { "type": "string", "format": "uuid" },
          "reason":    { "type": "string" }
        }
      },
      "QueryScope": {
        "type": "object",
        "properties": {
          "kind":       { "type": "string", "enum": ["event", "state"] },
          "property":   { "type": "string", "description": "Prefix match — 'interaction.email' matches email_sent and email_replied" },
          "source":     { "type": "string" },
          "entity_id":  { "type": "string", "format": "uuid" },
          "since_days": { "type": "number" },
          "limit":      { "type": "number", "default": 50, "maximum": 200 }
        }
      },
      "QueryItem": {
        "type": "object",
        "description": "Returned when request used return='observations' — one row per observation.",
        "properties": {
          "observation_id": { "type": "string", "format": "uuid" },
          "entity_id":      { "type": "string", "format": "uuid" },
          "entity_name":    { "type": "string", "nullable": true },
          "when":           { "type": "string", "format": "date-time" },
          "type":           { "type": "string" },
          "source":         { "type": "string" },
          "summary":        { "type": "string", "nullable": true },
          "similarity":     { "type": "number", "description": "Present in semantic mode (when question is set)" }
        }
      },
      "QueryEntityItem": {
        "type": "object",
        "description": "Returned when request used return='entities' — one row per entity, ranked by most-recent matching activity.",
        "properties": {
          "entity_id":           { "type": "string", "format": "uuid" },
          "entity_name":         { "type": "string", "nullable": true },
          "matches":             { "type": "integer", "description": "Observations in scope for this entity" },
          "most_recent_at":      { "type": "string", "format": "date-time" },
          "most_recent_type":    { "type": "string" },
          "most_recent_source":  { "type": "string" },
          "most_recent_summary": { "type": "string", "nullable": true },
          "most_recent_value":   { "description": "Present for state observations (funnel queries)" }
        }
      },
      "WorkspaceFact": {
        "type": "object",
        "properties": {
          "id":          { "type": "string", "format": "uuid" },
          "category":    { "type": "string", "description": "Common: ICP, Market, Product, Pricing, Competitors, Playbook" },
          "content":     { "type": "string" },
          "source":      { "type": "string" },
          "recorded_at": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" }, "message": { "type": "string" } }
      }
    }
  },
  "paths": {
    "/v2/context": {
      "post": {
        "summary": "Get engineered context",
        "description": "Engineered context for one task about one entity. Runs the pipeline: retrieve → rank → connect → compress → tag → budget.",
        "tags": ["Context"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["focus"],
                "properties": {
                  "focus":         { "type": "string", "description": "Entity UUID, email, domain, LinkedIn URL, or name" },
                  "intent":        { "type": "string", "enum": ["account_review", "draft_email", "follow_up", "meeting_prep", "call_prep"], "default": "account_review" },
                  "budget_tokens": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Engineered context block, or candidates if focus is ambiguous",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "entity":       { "type": "object" },
                        "summary":      { "type": "string" },
                        "claims":       { "type": "array", "items": { "$ref": "#/components/schemas/Claim" } },
                        "workspace":    { "type": "array", "items": { "type": "object" } },
                        "timeline":     { "type": "array", "items": { "type": "object" } },
                        "stakeholders": { "type": "array", "items": { "type": "object" } },
                        "predictions":  { "type": "array", "items": { "type": "object" } },
                        "meta":         { "type": "object" }
                      }
                    },
                    { "$ref": "#/components/schemas/AmbiguousFocus" }
                  ]
                }
              }
            }
          },
          "400": { "description": "focus_required or invalid_intent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "entity_not_found",                  "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v2/accounts/{id}": {
      "get": {
        "summary": "Get the full Account Record",
        "description": "Entity + every claim with epistemics + recent observation timeline.",
        "tags": ["Accounts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "URL-encoded entity UUID, email, domain, LinkedIn URL, or name" }
        ],
        "responses": {
          "200": {
            "description": "Account Record, or candidates if id is ambiguous",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/AccountRecord" },
                    { "$ref": "#/components/schemas/AmbiguousFocus" }
                  ]
                }
              }
            }
          },
          "404": { "description": "entity_not_found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v2/observations": {
      "post": {
        "summary": "Record observations",
        "description": "Append events or state observations. The substrate derives the new claims and tells you which were recomputed.",
        "tags": ["Observations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["focus", "observations"],
                "properties": {
                  "focus":        { "type": "string", "description": "Entity UUID, email, domain, or LinkedIn URL. NOT a bare name." },
                  "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Observation" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded count + which claims were recomputed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity_id":         { "type": "string", "format": "uuid" },
                    "recorded":          { "type": "integer" },
                    "claims_recomputed": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "400": { "description": "focus_and_observations_required or invalid_focus", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v2/query": {
      "post": {
        "summary": "Query a corpus of observations",
        "description": "Retrieve + summarise observations across many entities. Three composable powers: return='entities' groups by entity, without subtracts a set, rollups.by_value (when scope.kind='state') gives funnel-style counts.",
        "tags": ["Query"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["scope"],
                "properties": {
                  "scope": { "$ref": "#/components/schemas/QueryScope" },
                  "without": {
                    "$ref": "#/components/schemas/QueryScope",
                    "description": "Subtract entities matching this scope from the result. Same shape as scope. Enables 'sent but no reply', 'cooled in N days'."
                  },
                  "return": {
                    "type": "string",
                    "enum": ["observations", "entities"],
                    "default": "observations",
                    "description": "observations = one row per observation. entities = one row per entity, ranked by most-recent matching activity."
                  },
                  "question":      { "type": "string", "description": "Echoed in the response. When set (and `without` not set), enables semantic ranking via embeddings." },
                  "budget_tokens": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matched corpus + rollups. items shape depends on `return`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "scope":    { "$ref": "#/components/schemas/QueryScope" },
                    "without":  { "$ref": "#/components/schemas/QueryScope" },
                    "mode":     { "type": "string", "enum": ["structured", "semantic"] },
                    "return":   { "type": "string", "enum": ["observations", "entities"] },
                    "matched":  { "type": "integer" },
                    "returned": { "type": "integer" },
                    "sampled":  { "type": "boolean" },
                    "items": {
                      "type": "array",
                      "description": "QueryItem[] when return='observations', QueryEntityItem[] when return='entities'",
                      "items": {
                        "oneOf": [
                          { "$ref": "#/components/schemas/QueryItem" },
                          { "$ref": "#/components/schemas/QueryEntityItem" }
                        ]
                      }
                    },
                    "rollups": {
                      "type": "object",
                      "properties": {
                        "by_type":   { "type": "object", "additionalProperties": { "type": "integer" } },
                        "by_source": { "type": "object", "additionalProperties": { "type": "integer" } },
                        "by_value":  { "type": "object", "additionalProperties": { "type": "integer" }, "description": "Counts entities by current state value. Present only when scope.kind='state'." }
                      }
                    },
                    "question": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/attention": {
      "get": {
        "summary": "What needs attention",
        "description": "Workspace-wide ranked decisions: accounts gone quiet, key facts decayed. Each item ships with a suggested action.",
        "tags": ["Attention"],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "number", "default": 25, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Ranked attention items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "entity_id":        { "type": "string", "format": "uuid" },
                          "entity_name":      { "type": "string" },
                          "what":             { "type": "string", "enum": ["going_dark", "claim_stale", "prediction_unresolved", "decay_threshold"] },
                          "headline":         { "type": "string" },
                          "suggested_action": { "type": "string" },
                          "score":            { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/verify": {
      "post": {
        "summary": "Verify one claim",
        "description": "Re-derive one claim against current observations. Returns before + after — the calibration check.",
        "tags": ["Verify"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["focus", "property"],
                "properties": {
                  "focus":    { "type": "string" },
                  "property": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Before / after snapshots and a note",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "property": { "type": "string" },
                        "before":   { "$ref": "#/components/schemas/Claim" },
                        "after":    { "$ref": "#/components/schemas/Claim" },
                        "note":     { "type": "string" }
                      }
                    },
                    { "$ref": "#/components/schemas/AmbiguousFocus" }
                  ]
                }
              }
            }
          },
          "400": { "description": "focus_and_property_required" },
          "404": { "description": "claim_not_found or entity_not_found" }
        }
      }
    },
    "/v2/dedup": {
      "post": {
        "summary": "Classify cold-outbound identifiers",
        "description": "Cross-list dedup: net_new / engaged / recent / bounced / unsubscribed / suppressed. Up to 50,000 of each kind per call.",
        "tags": ["Dedup"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "emails":        { "type": "array", "items": { "type": "string", "format": "email" } },
                  "linkedin_urls": { "type": "array", "items": { "type": "string", "format": "uri" } }
                },
                "description": "At least one of emails or linkedin_urls required"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-identifier classifications + rollup summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/DedupItem" } },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "net_new":      { "type": "integer" },
                        "engaged":      { "type": "integer" },
                        "recent":       { "type": "integer" },
                        "bounced":      { "type": "integer" },
                        "unsubscribed": { "type": "integer" },
                        "suppressed":   { "type": "integer" },
                        "total":        { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "identifiers_required" },
          "413": { "description": "too_many (max 50,000 per kind per call)" }
        }
      }
    },
    "/v2/workspace/facts": {
      "get": {
        "summary": "Get workspace facts",
        "description": "Workspace-level facts the user has recorded about their own business: ICP, target market, product, pricing, competitors, playbook. Read-only.",
        "tags": ["Workspace Facts"],
        "parameters": [
          { "name": "categories", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list (e.g. 'ICP,Market'). Omit for all." },
          { "name": "limit",      "in": "query", "schema": { "type": "number", "default": 50, "maximum": 500 } }
        ],
        "responses": {
          "200": {
            "description": "Facts grouped by category",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "facts":       { "type": "array", "items": { "$ref": "#/components/schemas/WorkspaceFact" } },
                    "count":       { "type": "integer" },
                    "by_category": { "type": "object", "additionalProperties": { "type": "integer" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
